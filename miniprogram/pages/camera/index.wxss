.camera-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.stage {
  position: relative;
  height: 62vh;
  margin: 16rpx 24rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  background: #3e3630;
}

.stage__camera {
  width: 100%;
  height: 100%;
}

.stage__fallback {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fcf7df;
  background: linear-gradient(150deg, #4b4238, #2e2822);
}

/* ---------- 引导层 ---------- */
.guide {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.guide__thirds {
  position: absolute;
  inset: 0;
  background-image: linear-gradient(rgba(252, 247, 223, 0.16) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(252, 247, 223, 0.16) 2rpx, transparent 2rpx);
  background-size: 33.33% 33.33%;
}

.guide__head {
  position: absolute;
  left: 50%;
  top: 10%;
  transform: translateX(-50%);
  width: 46%;
  height: 46%;
  border: 4rpx dashed rgba(252, 247, 223, 0.75);
  border-radius: 50% 50% 46% 46%;
}

.guide__shoulder {
  position: absolute;
  left: 16%;
  right: 16%;
  top: 52%;
  height: 34%;
  border: 4rpx dashed rgba(252, 247, 223, 0.5);
  border-bottom: none;
  border-radius: 40% 40% 0 0;
}

.guide__center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: rgba(252, 247, 223, 0.85);
}

.hud {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(62, 54, 48, 0.62);
  color: #fcf7df;
}

.hud__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c7d3db;
}

.hud--dark .hud__dot {
  background: #a79a8a;
}

.hud--bright .hud__dot {
  background: #fcf7df;
}

.tip {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  color: #fcf7df;
  background: rgba(62, 54, 48, 0.55);
}

/* ---------- 控制区 ---------- */
.controls {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 60rpx 10rpx;
}

.ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.ctrl__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--c-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--c-ink);
}

.shutter-btn {
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  background: var(--c-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(62, 54, 48, 0.28);
}

.shutter-btn__inner {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(252, 247, 223, 0.9);
}

/* ---------- 质检 ---------- */
.shot {
  position: relative;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--c-blue-soft);
}

.shot__img {
  width: 100%;
  height: 100%;
}

.shot__badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(62, 54, 48, 0.7);
}

.shot__badge--ok {
  color: #fcf7df;
  font-size: 24rpx;
}

.shot__badge--warn {
  color: #f3c9a8;
  font-size: 24rpx;
}

.checks {
  margin-top: 20rpx;
}

.check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.check:last-child {
  border-bottom: none;
}

.check__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--c-blue-soft);
  flex: none;
}

.check__dot--pass {
  background: #a79a8a;
}

.check__dot--fail {
  background: #d08a72;
}

.check__name {
  font-size: 27rpx;
}

.check__state {
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.sheet__actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}
