.segs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.seg {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: var(--c-ink-2);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  transition: all 0.16s ease;
}

.seg:active {
  transform: scale(0.97);
}

.seg--on {
  background: var(--c-ink);
  color: var(--c-cream);
  border-color: var(--c-ink);
}

.doc {
  margin-top: 22rpx;
  max-height: 62vh;
  overflow-y: auto;
}

.doc__sec {
  margin-bottom: 26rpx;
}

.doc__h {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.doc__p {
  font-size: 25rpx;
  color: var(--c-ink-2);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.sign {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--r-md);
  background: rgba(199, 211, 219, 0.28);
}

.sign__row {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.sign__k {
  width: 170rpx;
  color: var(--c-ink-3);
  flex: none;
}
