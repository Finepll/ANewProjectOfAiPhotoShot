.head .freq {
  text-align: right;
}

.freq__num {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
}

/* ---------------- 分段 ---------------- */
.segs {
  display: flex;
  gap: 16rpx;
  margin: 26rpx 0 20rpx;
}

.seg {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--c-ink-2);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  transition: all 0.16s ease;
}

.seg:active {
  transform: scale(0.97);
}

.seg--on {
  background: var(--c-ink);
  color: var(--c-cream);
  border-color: var(--c-ink);
}

/* ---------------- 记录条目 ---------------- */
.rec {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  background: linear-gradient(150deg, var(--c-blue), rgba(167, 154, 138, 0.55));
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.rec__text {
  font-size: 24rpx;
  color: var(--c-cream);
  letter-spacing: 2rpx;
}

.rec__title {
  font-size: 28rpx;
  font-weight: 500;
}

.rec__tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.rec__del {
  font-size: 24rpx;
  color: var(--c-ink-3);
  padding: 10rpx 14rpx;
  flex: none;
}

.rec__del:active {
  color: #c0603f;
}

/* ---------------- 统计 ---------------- */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.stat {
  padding: 22rpx;
  border-radius: var(--r-md);
  background: rgba(199, 211, 219, 0.25);
}

.stat__num {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

/* ---------------- 暂存工程 ---------------- */
.draft {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.draft:last-child {
  border-bottom: none;
}
