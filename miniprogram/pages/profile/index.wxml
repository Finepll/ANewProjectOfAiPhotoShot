<view class="page">
  <!-- 账号 -->
  <view class="card user">
    <view class="row">
      <view class="user__avatar">{{user ? user.avatarText : '访'}}</view>
      <view class="grow">
        <view class="user__name">{{user ? user.nickname : '未登录'}}</view>
        <view class="tiny">{{user ? user.emailMask : '邮箱验证码登录，未注册自动注册'}}</view>
        <view class="rec__tags">
          <text class="tag {{member.active ? 'tag--ink' : 'tag--tan'}}">{{member.active ? member.planName : '免费用户'}}</text>
          <text class="tag" wx:if="{{user}}">含额度 {{quota}} 次</text>
        </view>
      </view>
      <view class="btn btn--sm {{user ? 'btn--ghost' : 'btn--primary'}}" bindtap="goLogin">{{user ? '切换账号' : '登录'}}</view>
    </view>
  </view>

  <!-- 额度与会员 -->
  <view class="card">
    <view class="between">
      <view class="title">云增强额度</view>
      <text class="tag">F-PAY</text>
    </view>
    <view class="row" style="margin-top: 18rpx; align-items: flex-end">
      <view class="quota__num">{{quota}}</view>
      <view class="tiny grow" style="padding-bottom: 10rpx">
        次可用 · {{member.active ? (member.expireAt || '已开通') : '端侧能力全部免费，付费只买云增强'}}
      </view>
      <view class="btn btn--sm btn--blue" bindtap="goMember">{{member.active ? '续费' : '开通会员'}}</view>
    </view>
    <view class="notice" style="margin-top: 18rpx">
      <text>说明</text>
      <text class="grow">会员只卖「云增强次数与模型档位」，端侧全部能力保持免费可用，付费不改变隐私口径。</text>
    </view>
  </view>

  <!-- F-ACC-03 隐私看板 -->
  <view class="card">
    <view class="between">
      <view class="title">隐私看板</view>
      <text class="tag tag--tan">F-ACC-03</text>
    </view>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat__num">{{privacy.localMode ? '本地模式' : '混合模式'}}</view>
        <view class="tiny">当前存储档位</view>
      </view>
      <view class="stat">
        <view class="stat__num">{{privacy.upCount || 0}}</view>
        <view class="tiny">本次账号上行次数（本机统计）</view>
      </view>
      <view class="stat">
        <view class="stat__num">{{storage}}</view>
        <view class="tiny">小程序沙盒占用</view>
      </view>
      <view class="stat">
        <view class="stat__num">{{privacy.autoCleanDays}} 天</view>
        <view class="tiny">临时文件自动清理</view>
      </view>
    </view>

    <view class="board">
      <view class="board__row" wx:for="{{privacyItems}}" wx:key="key">
        <view class="grow">
          <view class="board__name">{{item.name}}</view>
          <view class="tiny">{{item.where}} · {{item.keep}}</view>
        </view>
        <text class="tag {{item.tagClass}}">{{item.risk}}</text>
      </view>
    </view>

    <view class="grid-2" style="margin-top: 20rpx">
      <view class="btn btn--ghost" bindtap="openDrafts">暂存工程（{{drafts.length}}）</view>
      <view class="btn btn--primary" bindtap="cleanAll">一键清理</view>
    </view>
  </view>

  <!-- 授权开关 -->
  <view class="card">
    <view class="between">
      <view class="title">授权与留存</view>
      <text class="tag">F-ACC-04</text>
    </view>
    <view class="switch-row">
      <view class="grow">
        <view class="board__name">本地隐私模式</view>
        <view class="tiny">默认开启：照片、蒙版与工程参数只在本次会话内存中存在</view>
      </view>
      <switch checked="{{privacy.localMode}}" color="#3E3630" bindchange="toggleLocalMode" />
    </view>
    <view class="switch-row">
      <view class="grow">
        <view class="board__name">允许使用云增强</view>
        <view class="tiny">首次使用仍会逐次确认；拒绝后其余端侧能力不受影响</view>
      </view>
      <switch checked="{{privacy.cloudAllowed}}" color="#3E3630" bindchange="toggleCloud" />
    </view>
    <view class="switch-row">
      <view class="grow">
        <view class="board__name">在本机保留人脸特征</view>
        <view class="tiny">默认关闭；开启仅存本机、不同步、随时可清除</view>
      </view>
      <switch checked="{{privacy.faceFeatureSaved}}" color="#3E3630" bindchange="toggleFaceFeature" />
    </view>
    <picker mode="selector" range="{{cleanDays}}" value="{{cleanIndex}}" bindchange="onCleanDays">
      <view class="cell">
        <view class="cell__icon">◷</view>
        <view class="grow">
          <view class="board__name">临时文件自动清理</view>
          <view class="tiny">沙盒只作临时工作区，到期自动清理</view>
        </view>
        <text class="cell__arrow">{{privacy.autoCleanDays}} 天 ›</text>
      </view>
    </picker>
  </view>

  <!-- 常用入口 -->
  <view class="card card--tight">
    <view class="cell" bindtap="goOrders">
      <view class="cell__icon">▤</view>
      <view class="grow">
        <view class="board__name">我的订单与账单</view>
        <view class="tiny">订单号、支付状态、退款进度</view>
      </view>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" data-type="portrait" bindtap="goAgreement">
      <view class="cell__icon">✍</view>
      <view class="grow">
        <view class="board__name">肖像权授权承诺</view>
        <view class="tiny">{{agreements.portrait ? '已签署 · ' + agreements.signedAt : '未签署，拍摄与导出不可用'}}</view>
      </view>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" data-type="privacy" bindtap="goAgreement">
      <view class="cell__icon">🔒</view>
      <view class="grow">
        <view class="board__name">隐私政策</view>
        <view class="tiny">照片不出本机、不建长期作品库</view>
      </view>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" data-type="service" bindtap="goAgreement">
      <view class="cell__icon">📄</view>
      <view class="grow">
        <view class="board__name">用户服务协议</view>
        <view class="tiny">会员、支付、退款与内容规范</view>
      </view>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <view>
        <view class="board__name">{{version}}</view>
        <view class="tiny">SpringBoot + 微信小程序 · 演示环境数据均在本机</view>
      </view>
      <text class="tag tag--outline">演示</text>
    </view>
    <view class="divider"></view>
    <view class="btn btn--ghost btn--block" wx:if="{{user}}" bindtap="logout">退出登录</view>
    <view class="btn btn--primary btn--block" wx:else bindtap="goLogin">邮箱登录</view>
  </view>

  <view class="notice" style="margin-top: 24rpx">
    <text>红线</text>
    <text class="grow">仅支持本人肖像；不得用于伪造证件、恶搞他人或商业侵权合成，违规由上传者承担法律责任。</text>
  </view>

  <!-- 暂存工程 -->
  <view class="mask" wx:if="{{showDrafts}}" bindtap="closeDrafts">
    <view class="sheet" catchtap="noop">
      <view class="sheet__title">暂存工程（{{drafts.length}}）</view>
      <view class="tiny" style="margin-bottom: 10rpx">只保存工程参数与素材引用，不含照片；默认 {{privacy.autoCleanDays}} 天后自动清理。</view>
      <scroll-view scroll-y class="draft-scroll">
        <view class="cell" wx:for="{{drafts}}" wx:key="id">
          <view class="cell__icon">▦</view>
          <view class="grow">
            <view class="board__name">工程 {{item.id}}</view>
            <view class="tiny">{{item.createdAt}} · 缩放 {{item.zoom}} · 羽化 {{item.feather}}</view>
          </view>
          <text class="rec__del" data-id="{{item.id}}" bindtap="removeDraft">删除</text>
        </view>
        <view class="empty" wx:if="{{!drafts.length}}">
          <text class="tiny">暂无暂存工程</text>
        </view>
      </scroll-view>
      <view class="grid-2" style="margin-top: 20rpx">
        <view class="btn btn--ghost" bindtap="closeDrafts">关闭</view>
        <view class="btn btn--primary" bindtap="clearDrafts">全部清理</view>
      </view>
    </view>
  </view>
</view>
