.segs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.seg {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: var(--c-ink-2);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  transition: all 0.16s ease;
}

.seg:active {
  transform: scale(0.97);
}

.seg--on {
  background: var(--c-ink);
  color: var(--c-cream);
  border-color: var(--c-ink);
}

.banner {
  background: linear-gradient(140deg, rgba(199, 211, 219, 0.75), rgba(167, 154, 138, 0.6));
}

.banner--on {
  background: linear-gradient(140deg, var(--c-blue), rgba(167, 154, 138, 0.9));
}

.banner__title {
  font-size: 36rpx;
  font-weight: 600;
}

.banner__sub {
  font-size: 23rpx;
  color: rgba(62, 54, 48, 0.72);
  margin-top: 8rpx;
}

.banner__quota {
  text-align: right;
}

.banner__num {
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1;
}

/* ---------------- 筛选 ---------------- */
.filters {
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.filters__track {
  display: inline-flex;
  gap: 14rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--c-tan-soft);
  font-size: 24rpx;
  color: var(--c-ink-2);
  transition: all 0.16s ease;
}

.chip--on {
  background: var(--c-ink);
  color: var(--c-cream);
}

/* ---------------- 订单 ---------------- */
.order {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.order:last-child {
  border-bottom: none;
}

.order__name {
  font-size: 29rpx;
  font-weight: 600;
}

.order__row {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
}

.order__k {
  width: 180rpx;
  flex: none;
  color: var(--c-ink-3);
}

.order__ops {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.op {
  font-size: 25rpx;
  color: var(--c-ink);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(199, 211, 219, 0.4);
}

.op:active {
  transform: scale(0.96);
}

.op--mute {
  background: transparent;
  color: var(--c-ink-3);
}

.board__name {
  font-size: 28rpx;
  font-weight: 500;
}

.draft {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.draft:last-child {
  border-bottom: none;
}

/* ---------------- 弹层 ---------------- */
.meta__row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--c-line);
  font-size: 27rpx;
}

.meta__k {
  width: 180rpx;
  color: var(--c-ink-2);
  flex: none;
}

.remark {
  width: 100%;
  min-height: 150rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: var(--r-md);
  background: var(--c-blue-soft);
  font-size: 26rpx;
}
